{
  "expo": {
    "name": "RatesVenApp",
    "slug": "ratesvenapp",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/images/logo.png",
    "scheme": "ratesvenapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.devlopez.ratesvenapp",
      "icon": "./assets/images/logo.png",
      "infoPlist": {
        "CADisableMinimumFrameDurationOnPhone": true
      }
    },
    "android": {
      "package": "com.devlopez.ratesvenapp",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#ffffff",
        "foregroundImage": "./assets/images/logo.png",
        "backgroundImage": "./assets/images/logo.png",
        "monochromeImage": "./assets/images/logo.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/logo.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#ff6b26",
          "image": "./assets/images/logo.png",
          "imageWidth": 160
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "f397f00a-1106-4649-89cc-dc82879462ad"
      }
    }
  }
}
